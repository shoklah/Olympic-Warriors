SECRET_KEY=
DEBUG=True

DB_HOST=db
DB_NAME=mydb-dev
DB_USER=user
DB_PASS=password
DB_PORT=5433

LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=INFO
LOG_FILE=logs/olympic_warriors.log

SU_USERNAME=admin
SU_PASSWORD=password

BASE_URL="http://localhost:3003"

# The front's public address, the base of the claim links the admin generates
# (<PUBLIC_URL>/claim/<uid>/<token>), e.g. https://olympicwarriors.com. Optional: without an
# absolute http(s) address the admin refuses to make links, and the rest works. Dev defaults
# to the Vite dev server, http://localhost:5173.
PUBLIC_URL=http://localhost:5173

ALLOWED_HOSTS=["localhost","127.0.0.1","server"]
CSRF_TRUSTED_ORIGINS=["https://*", "http://*"]

# Login throttle on /auth/token/, /admin/login/ and a claim link's POST together: attempts per
# client IP, and how many X-Forwarded-For hops (nginx, or the front calling the API for its
# visitor) are trusted to name that IP.
LOGIN_THROTTLE_RATE=5/min
NUM_PROXIES=1

# Photo uploads per user (PUT /me/photo/); taking a photo down is never limited.
PHOTO_THROTTLE_RATE=10/hour
